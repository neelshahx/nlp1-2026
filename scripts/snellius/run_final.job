#!/bin/bash
# Final evaluation: refit the chosen configs on full train and score dev + test once (scripts/run_final.py). Configs that
# already have final scores are skipped (never rerun), so a timed-out job can be resubmitted.
# One-time setup (venv, GloVe, HF + BERT cache): see scripts/snellius/run_grid.job.
# Submit from the repo root on Snellius, after scripts/run_ensembles.py:
#   sbatch --time=03:00:00 scripts/snellius/run_final.job grids/final.json
#SBATCH --job-name=nli-final
#SBATCH --partition=gpu_mig          # A100 slice; switch to gpu_a100 if memory/speed is a problem
#SBATCH --gpus=1
#SBATCH --cpus-per-task=9
#SBATCH --time=03:00:00
#SBATCH --output=slurm-%x-%j.out
# #SBATCH --account=<your-budget>    # fill in if you have more than one budget

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

export HF_DATASETS_OFFLINE=1         # use the cache warmed on the login node
export HF_HUB_OFFLINE=1              # same for BERT weights (warm: see run_grid.job)
export PYTHONUNBUFFERED=1
nvidia-smi || true

if [[ -n "${CONDA_ENV:-}" ]]; then
    [[ -n "${CONDA_MODULE:-}" ]] && module load "$CONDA_MODULE"
    eval "$(conda shell.bash hook)"
    conda activate "$CONDA_ENV"
    PY=python
else
    PY="$SLURM_SUBMIT_DIR/.venv/bin/python"   # built by `uv sync` on the login node; no uv needed here
fi
"$PY" -c "import sys, torch; print(sys.executable, torch.__version__, 'cuda', torch.cuda.is_available()); assert torch.cuda.is_available(), 'no GPU visible; refusing to train on CPU'"

"$PY" scripts/run_final.py "$@"
